{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@meals/*": [
        "./modules/meals/*"
      ],
      "@arcade/*": [
        "./modules/arcade/*"
      ],
      "@movies/*": [
        "./modules/movies/*"
      ],
      "@projects/*": [
        "./modules/projects/*"
      ],
      "@restock/*": [
        "./modules/restock/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "modules/meals/_routes_src",
    "node_modules",
    "tests"
  ]
}
