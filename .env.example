# Copy to .env and fill in values. Never commit .env.

AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin login (single user — email + password, no magic link)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Neon Postgres — pooled for app, unpooled for npm run db:schema / migrations
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
AUTO_REPLY_FROM_EMAIL=
# Outreach sender — must be on a Resend-verified domain.
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=King Street Sites
OUTREACH_REPLY_TO=
# Resend receiving address used as Reply-To with plus-addressed lead ids
# (e.g. info+<lead-uuid>@kingstreetsites.com). Webhook: /api/webhooks/resend
OUTREACH_INBOUND_EMAIL=

# Vercel Blob — payment receipt uploads (Storage → Blob in Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=

# Production scrape/analyze — GitHub Actions (Vercel has no Python)
GITHUB_AGENT_TOKEN=
# Optional: defaults to jtomassoni/kingstreetsites
# GITHUB_REPOSITORY=
# GITHUB_AGENT_REF=main
# GitHub Actions repo secrets (Settings → Secrets → Actions): DATABASE_URL, GOOGLE_PLACES_API_KEY, ANTHROPIC_API_KEY

AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── App dashboard login (/tools) ────────────────────────────────────
# Format: email:password  (passwords must not contain commas)
# Super admin — all household apps + Business CRM (/admin)
SUPER_ADMIN_USERS=james@example.com:change-me
# App users — all household apps, no CRM
APP_USERS=mary@example.com:change-me
# Long random string (16+ chars). Falls back to SESSION_SECRET if unset.
TOOLS_SESSION_SECRET=
# Legacy (still accepted): TOOLS_AUTH_USERS, CRM_AUTH_USERS, AUTH_USERS
# Existing Meal Planner Neon database (NOT the CRM DATABASE_URL above)
MEALS_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
MEALS_DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DEFAULT_HOUSEHOLD_NAME=JT and Mary
# Optional Meal Planner AI (server-only)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Arcade shared scoreboard (optional; local uses .data/board.json)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Legacy Meal Planner names still accepted as fallbacks:
# AUTH_USERS=…   SESSION_SECRET=…

# ── Restock Tracker (/tools/restock-tracker) ────────────────────────
# Vercel Cron auth (Authorization: Bearer <CRON_SECRET>). Required in production.
CRON_SECRET=
# Optional comma-separated default alert recipients (also editable in the dashboard).
RESTOCK_ALERT_EMAILS=
# Optional sender; falls back to CONTACT_FROM_EMAIL / OUTREACH_FROM_EMAIL.
RESTOCK_FROM_EMAIL=
# Official Best Buy in-store availability API (developer.bestbuy.com). Without
# this key, Best Buy stays unverified — the public storefront is blocked to bots.
BESTBUY_API_KEY=
# Optional: disable Playwright fallback (GameStop Cloudflare).
# RESTOCK_DISABLE_BROWSER=1
# Optional local Chrome path if the default is wrong.
# RESTOCK_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
